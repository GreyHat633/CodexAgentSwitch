<Page
    x:Class="CodexAgentSwitch.App.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CodexAgentSwitch.App.Views"
    SizeChanged="OnPageSizeChanged">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid HorizontalAlignment="Stretch">
            <StackPanel x:Name="ContentContainer" MaxWidth="{StaticResource PageContentMaxWidth}" HorizontalAlignment="Center" Padding="{StaticResource PagePadding}" Spacing="20">
                <local:PageHeader Title="欢迎使用 Codex Agent Switch" Subtitle="五步完成真实、可返回的首次配置；所有配置都将保存为可再次编辑的 Profile。" />

                <ProgressBar x:Name="OnboardingProgress" Maximum="5" Value="1" AutomationProperties.Name="首次启动向导，第 1 步，共 5 步" />
                <Grid x:Name="StepIndicatorGrid" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="Step1Text" Text="1 环境" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="Step2Text" Grid.Column="1" Text="2 主代理" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="Step3Text" Grid.Column="2" Text="3 工作代理" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="Step4Text" Grid.Column="3" Text="4 服务商" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="Step5Text" Grid.Column="4" Text="5 确认" TextTrimming="CharacterEllipsis" />
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock x:Name="StepTitleText" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock x:Name="StepDescriptionText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                </StackPanel>

                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <StackPanel x:Name="EnvironmentStepPanel" Spacing="12" AutomationProperties.Name="EnvironmentChecksPanel">
                            <TextBlock Text="以下检测只读取本机状态，不会修改 Codex 或凭据。" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="12" RowSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <FontIcon Grid.Row="0" Glyph="&#xE73E;" /><TextBlock x:Name="CliStatusText" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" />
                                <FontIcon Grid.Row="1" Glyph="&#xE73E;" /><TextBlock x:Name="DesktopStatusText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" />
                                <FontIcon Grid.Row="2" Glyph="&#xE73E;" /><TextBlock x:Name="AppServerStatusText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" />
                                <FontIcon Grid.Row="3" Glyph="&#xE73E;" /><TextBlock x:Name="ConfigDirectoryText" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" />
                                <FontIcon Grid.Row="4" Glyph="&#xE73E;" /><TextBlock x:Name="RuntimeStatusText" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" />
                            </Grid>
                            <Button Content="重新检测" HorizontalAlignment="Left" Click="RefreshEnvironment" />
                        </StackPanel>

                        <StackPanel x:Name="MainAgentStepPanel" Visibility="Collapsed" Spacing="14" AutomationProperties.Name="MainAgentCards">
                            <TextBlock x:Name="MainAgentAvailabilityText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                            <Grid x:Name="AgentCardsGrid" ColumnSpacing="14" RowSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition x:Name="AgentColumnOne" Width="*" /><ColumnDefinition x:Name="AgentColumnTwo" Width="*" /><ColumnDefinition x:Name="AgentColumnThree" Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border x:Name="SolCard" Style="{StaticResource CardBorderStyle}"><StackPanel Spacing="10"><FontIcon Glyph="&#xE8D4;" FontSize="26" /><TextBlock Text="Sol" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="适合复杂规划和最终整合。" TextWrapping="Wrap" /><RadioButton x:Name="SolRadio" Content="选择 Sol" GroupName="MainAgent" Tag="gpt-5.6-sol" Checked="MainAgentChecked" /><TextBlock x:Name="SolAvailabilityText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" /></StackPanel></Border>
                                <Border x:Name="TerraCard" Grid.Column="1" Style="{StaticResource CardBorderStyle}"><StackPanel Spacing="10"><FontIcon Glyph="&#xE8EF;" FontSize="26" /><TextBlock Text="Terra" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="适合大型读取、扫描和分析。" TextWrapping="Wrap" /><RadioButton x:Name="TerraRadio" Content="选择 Terra" GroupName="MainAgent" Tag="gpt-5.6-terra" Checked="MainAgentChecked" /><TextBlock x:Name="TerraAvailabilityText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" /></StackPanel></Border>
                                <Border x:Name="LunaCard" Grid.Column="2" Style="{StaticResource CardBorderStyle}"><StackPanel Spacing="10"><FontIcon Glyph="&#xE74C;" FontSize="26" /><TextBlock Text="Luna" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="适合明确、轻量的任务。" TextWrapping="Wrap" /><RadioButton x:Name="LunaRadio" Content="选择 Luna" GroupName="MainAgent" Tag="gpt-5.6-luna" Checked="MainAgentChecked" /><TextBlock x:Name="LunaAvailabilityText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" /></StackPanel></Border>
                            </Grid>
                            <ComboBox x:Name="ReasoningEffortComboBox" Header="推理强度" SelectionChanged="ReasoningEffortChanged" AutomationProperties.Name="主代理推理强度" />
                        </StackPanel>

                        <StackPanel x:Name="WorkerStepPanel" Visibility="Collapsed" Spacing="14" AutomationProperties.Name="WorkerSourceSelector">
                            <RadioButton x:Name="NoWorkerRadio" Content="不启用 Worker：所有任务由主代理处理" GroupName="WorkerSource" Tag="disabled" Checked="WorkerSourceChecked" />
                            <RadioButton x:Name="NativeWorkerRadio" Content="原生 Worker：由 Codex 原生能力执行" GroupName="WorkerSource" Tag="native" Checked="WorkerSourceChecked" />
                            <RadioButton x:Name="ExternalWorkerRadio" Content="外部 Provider：由 Agent Switch 宿主调用外部模型" GroupName="WorkerSource" Tag="external" Checked="WorkerSourceChecked" />
                            <StackPanel x:Name="NativeWorkerPanel" Spacing="10" Visibility="Collapsed">
                                <ComboBox x:Name="NativeWorkerComboBox" Header="原生 Worker" SelectedIndex="0"><ComboBoxItem Content="Luna" Tag="native-luna" /><ComboBoxItem Content="Terra" Tag="native-terra" /><ComboBoxItem Content="Sol" Tag="native-sol" /></ComboBox>
                            </StackPanel>
                            <StackPanel x:Name="ExternalWorkerPanel" Spacing="10" Visibility="Collapsed">
                                <ComboBox x:Name="ExternalProviderComboBox" Header="外部 Provider" SelectionChanged="ExternalProviderSelectionChanged" AutomationProperties.Name="外部 Provider" />
                            </StackPanel>
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <NumberBox x:Name="MaxWorkersBox" Header="最大 Worker 数量" Minimum="1" Maximum="3" Value="1" SpinButtonPlacementMode="Compact" />
                                <ComboBox x:Name="RoutingModeComboBox" Grid.Column="1" Header="路由方式" SelectedIndex="1"><ComboBoxItem Content="经济" Tag="Economic" /><ComboBoxItem Content="平衡" Tag="Balanced" /><ComboBoxItem Content="性能" Tag="Performance" /><ComboBoxItem Content="手动" Tag="Manual" /><ComboBoxItem Content="单代理" Tag="Single" /></ComboBox>
                                <ComboBox x:Name="FallbackComboBox" Grid.Row="1" Header="失败时" SelectedIndex="0"><ComboBoxItem Content="请求确认" Tag="AskUser" /><ComboBoxItem Content="由主代理继续" Tag="SingleAgent" /><ComboBoxItem Content="停止委派" Tag="StopDelegation" /><ComboBoxItem Content="原生 Luna" Tag="NativeLuna" /></ComboBox>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="ProviderStepPanel" Visibility="Collapsed" Spacing="14">
                            <InfoBar x:Name="NoProviderRequiredPanel" IsOpen="True" Severity="Informational" Title="本步骤无需配置" Message="当前未选择外部 Worker；可直接进入确认步骤。" />
                            <StackPanel x:Name="ProviderConfigurationPanel" Spacing="12" Visibility="Collapsed" AutomationProperties.Name="ProviderConfigurationPanel">
                                <TextBlock Text="外部 Provider 的 API Key 仅保存至 Windows 凭据管理器，不会写入 Profile 或日志。" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                <ComboBox x:Name="ProviderSetupComboBox" Header="服务商" SelectionChanged="ProviderSetupSelectionChanged" />
                                <TextBox x:Name="ProviderBaseUrlBox" Header="Base URL" Text="https://api.deepseek.com" />
                                <ComboBox x:Name="ProviderModelComboBox" Header="模型" DisplayMemberPath="DisplayName" />
                                <PasswordBox x:Name="ProviderApiKeyBox" Header="API Key（留空则保持已保存的密钥）" />
                                <Button x:Name="TestProviderButton" Content="测试并安全保存连接" HorizontalAlignment="Left" Click="TestProviderConnection" />
                                <TextBlock x:Name="ProviderTestResultText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="ConfirmStepPanel" Visibility="Collapsed" Spacing="14" AutomationProperties.Name="ProfileSummaryPanel">
                            <TextBox x:Name="ProfileNameBox" Header="方案名称" Text="首次启动方案" PlaceholderText="请输入方案名称" />
                            <TextBlock x:Name="ProfileSummaryText" TextWrapping="Wrap" />
                            <TextBlock Text="完成后将创建真实 Profile、设为默认并保存到本地数据库；API Key 不会进入 Profile。" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <InfoBar x:Name="OnboardingActionBar" IsOpen="False" IsClosable="True" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Content="返回" Tag="onboarding:back" />
                    <Button x:Name="NextButton" Grid.Column="2" Content="下一步" Style="{StaticResource HeroButtonStyle}" Tag="onboarding:next" />
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
