<Page
    x:Class="CodexAgentSwitch.App.Views.ProvidersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CodexAgentSwitch.App.Views">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="24" MaxWidth="1180">
            <Grid>
                <local:PageHeader Title="Provider" Subtitle="管理原生 Codex 与 OpenAI-Compatible Provider；停用不会删除凭据。" />
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="添加 Provider" Style="{StaticResource AccentButtonStyle}" />
            </Grid>
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="12" Background="{ThemeResource AccentFillColorSecondaryBrush}">
                        <FontIcon Glyph="&#xE8D4;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="原生 Codex" Style="{StaticResource SectionTitleStyle}" />
                            <Border Style="{StaticResource StatusBadgeStyle}"><TextBlock Text="已连接" Foreground="{ThemeResource SuccessBrush}" /></Border>
                        </StackPanel>
                        <TextBlock Text="Sol · Terra · Luna · 推理强度由当前 App Server 动态发现" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Text="无需额外 API Key" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="测试" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="12" Background="{ThemeResource SubtleBackgroundBrush}">
                        <FontIcon Glyph="&#xE774;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="DeepSeek" Style="{StaticResource SectionTitleStyle}" />
                            <Border Style="{StaticResource StatusBadgeStyle}"><TextBlock Text="未配置" /></Border>
                        </StackPanel>
                        <TextBlock Text="内置 OpenAI-Compatible 预设" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Text="凭据：未配置 · 今日费用：不可用" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="配置" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="停用" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Border>
            <Expander Header="添加通用 OpenAI-Compatible Provider">
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="8">
                                <TextBlock Text="名称" />
                                <TextBox PlaceholderText="例如：团队网关" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock Text="Base URL" />
                                <TextBox PlaceholderText="https://api.example.com/v1" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="8">
                                <TextBlock Text="API Key" />
                                <PasswordBox PlaceholderText="安全保存到 Windows 凭据存储" PasswordRevealMode="Peek" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock Text="Model ID" />
                                <TextBox PlaceholderText="连接成功后获取，或手动输入" />
                            </StackPanel>
                        </Grid>
                        <InfoBar IsOpen="True" Severity="Warning" Title="HTTPS 安全要求" Message="非本机地址使用 HTTP 时会要求额外确认，API Key 不会写入配置或日志。" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="测试连接" Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="清空 Key" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
