<Page x:Class="CodexAgentSwitch.App.Views.ProvidersPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:CodexAgentSwitch.App.Views">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Padding="{StaticResource PagePadding}" Spacing="20" MaxWidth="{StaticResource PageContentMaxWidth}" HorizontalAlignment="Center">
    <Grid><local:PageHeader Title="服务商" Subtitle="状态来自统一 UI 投影；测试仅在用户明确点击时执行。"/><Button HorizontalAlignment="Right" Content="添加服务商" Style="{StaticResource AccentButtonStyle}" Tag="provider:add"/></Grid>
    <StackPanel x:Name="ProviderCardsPanel" Spacing="12"><TextBlock x:Name="DeepSeekStatusText" Visibility="Collapsed"/><TextBlock x:Name="DeepSeekDetailText" Visibility="Collapsed"/></StackPanel>
    <Expander x:Name="ProviderEditor" Header="配置 DeepSeek / 通用 OpenAI 兼容服务">
      <Border Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0"><StackPanel Spacing="14">
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Spacing="6"><TextBlock Text="名称"/><TextBox x:Name="ProviderNameText" Text="DeepSeek"/></StackPanel><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="基础地址"/><TextBox x:Name="BaseUrlText" Text="https://api.deepseek.com"/></StackPanel></Grid>
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Spacing="6"><TextBlock Text="API 密钥"/><PasswordBox x:Name="ApiKeyBox" PasswordRevealMode="Peek"/></StackPanel><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="模型"/><ComboBox x:Name="ModelSelectionComboBox" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectionChanged="ModelSelectionChanged"/></StackPanel></Grid>
        <InfoBar IsOpen="True" Severity="Warning" Title="HTTPS 安全要求" Message="非本机地址使用 HTTP 时会要求额外确认；API 密钥不会写入配置或日志。"/>
        <StackPanel Orientation="Vertical" Spacing="8" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="SaveProviderButton" Content="保存" Click="SaveProvider"/><Button x:Name="TestConnectionButton" Content="测试并启用" Style="{StaticResource AccentButtonStyle}" Click="TestAndSaveProvider"/><Button x:Name="EnableDeepSeekButton" Content="启用" Click="EnableDeepSeek"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="删除服务商" Click="DeleteDeepSeek"/><Button Content="重载" Click="ReloadProviders"/><Button Content="清空密钥" Click="ClearProviderKey"/></StackPanel></StackPanel>
      </StackPanel></Border>
    </Expander>
    <InfoBar x:Name="ProviderResultBar" IsOpen="False"/>
  </StackPanel></ScrollViewer>
</Page>
