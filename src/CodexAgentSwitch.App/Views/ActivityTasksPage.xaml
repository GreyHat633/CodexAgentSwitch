<Page
    x:Class="CodexAgentSwitch.App.Views.ActivityTasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CodexAgentSwitch.App.Views">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="18" MaxWidth="{StaticResource PageContentMaxWidth}" HorizontalAlignment="Center">
            <local:PageHeader
                Title="活动任务"
                Subtitle="查看 Agent Switch 当前正在处理的 Worker 任务及最近结果。" />
            <InfoBar x:Name="LoadErrorBar" IsOpen="False" Severity="Error" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="正在进行" Style="{StaticResource SectionTitleStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ActiveTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14" Margin="0,0,0,8" CornerRadius="8" Background="{ThemeResource ControlFillColorDefaultBrush}">
                                    <Grid ColumnSpacing="16" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Project}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Profile}" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding Worker}" />
                                            <TextBlock Text="{Binding Updated}" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Duration}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ActiveEmptyText" Text="当前没有活动任务。&#x0a;Agent Switch 已就绪；当 Sol 委派 Worker 后，会在这里显示运行状态。" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="最近结果" Style="{StaticResource SectionTitleStyle}" />
                    <ItemsControl ItemsSource="{x:Bind RecentTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10,8" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Project}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Failure}" Visibility="{Binding FailureVisibility}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Worker}" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding Updated}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="RecentEmptyText" Text="暂无任务记录。" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
