<Page
    x:Class="CodexAgentSwitch.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CodexAgentSwitch.App.Views">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="22" MaxWidth="1180" HorizontalAlignment="Stretch">
            <local:PageHeader
                Title="选择工作模式"
                Subtitle="原生 Codex 使用原版界面；CodexAgentSwitch 模式在本程序内完整管理项目、对话、Worker、预算与 Usage。" />
            <InfoBar x:Name="DashboardActionBar" IsOpen="False" />

            <Grid x:Name="ModeGrid" ColumnSpacing="14" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="NativeModeCard" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <Grid RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="8">
                            <TextBlock Text="原生 Codex 模式" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="配置并启动原生 Codex" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="应用当前方案的主模型、推理强度和 Worker 配置，然后交由原版 Codex 界面运行。Agent Switch 不监控完整会话，也不声称精确统计主线程 Usage。" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                        </StackPanel>
                        <Button Grid.Row="1" Content="配置并启动" HorizontalAlignment="Left" Style="{StaticResource HeroButtonStyle}" Tag="dashboard:launch-native" AutomationProperties.Name="配置并启动原生 Codex" />
                    </Grid>
                </Border>
                <Border x:Name="ManagedModeCard" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <Grid RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="8">
                            <TextBlock Text="CodexAgentSwitch 模式" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="本程序内的受控对话客户端" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="按项目创建和恢复对话；同一对话持续绑定主 Thread，并记录真实 Worker、预算、Usage、历史和归档。" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                        </StackPanel>
                        <Button Grid.Row="1" Content="进入模式" HorizontalAlignment="Left" Style="{StaticResource HeroButtonStyle}" Tag="navigate:tasks" AutomationProperties.Name="进入 CodexAgentSwitch 模式" />
                    </Grid>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorderStyle}" Background="{ThemeResource AccentFillColorDefaultBrush}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="ProfileNameText" Text="正在加载方案" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <TextBlock x:Name="AgentSummaryText" Text="正在读取本地配置" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <TextBlock x:Name="WorkerPolicyText" Text="正在解析 Worker 配置" TextWrapping="Wrap" Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="编辑方案" VerticalAlignment="Center" Tag="navigate:profiles" />
                </Grid>
            </Border>

            <Grid x:Name="StatusGrid" ColumnSpacing="14" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="MainAgentCard" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="主代理" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="MainAgentNameText" Text="正在加载" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock x:Name="MainReasoningText" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="负责规划、集成与最终回答" Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                </Border>
                <Border x:Name="WorkerCard" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="工作代理" Style="{StaticResource SectionTitleStyle}" />
                            <Border HorizontalAlignment="Right" Style="{StaticResource StatusBadgeStyle}">
                                <TextBlock x:Name="WorkerSourceBadgeText" Text="正在加载" />
                            </Border>
                        </Grid>
                        <TextBlock x:Name="WorkerNameText" Text="正在加载" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="WorkerDescriptionText" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                        <Button Content="编辑方案" HorizontalAlignment="Left" Tag="navigate:profiles" />
                    </StackPanel>
                </Border>
                <Border x:Name="BudgetCard" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="预算" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="BudgetSummaryText" Text="正在加载" FontSize="24" FontWeight="SemiBold" />
                        <ProgressBar x:Name="BudgetProgressBar" Value="0" Maximum="100" />
                        <TextBlock x:Name="BudgetStateText" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock x:Name="LatestTaskTitleText" Text="最近对话" Style="{StaticResource SectionTitleStyle}" />
                            <Button Content="打开对话" HorizontalAlignment="Right" Tag="navigate:tasks" />
                        </Grid>
                        <TextBlock x:Name="LatestTaskSummaryText" Text="尚无对话。" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                        <InfoBar x:Name="LatestTaskInfoBar" IsOpen="False" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" MinWidth="0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="环境状态" Style="{StaticResource SectionTitleStyle}" />
                        <Grid ColumnSpacing="10" MinWidth="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon x:Name="CodexStatusIcon" Glyph="&#xE73E;" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <TextBlock x:Name="CodexDetectedText" Grid.Column="1" Text="Codex 尚未检测" TextWrapping="Wrap" MinWidth="0" />
                        </Grid>
                        <Grid ColumnSpacing="10" MinWidth="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon x:Name="AppServerStatusIcon" Glyph="&#xE73E;" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <TextBlock x:Name="AppServerStatusText" Grid.Column="1" Text="受控服务按需启动" TextWrapping="Wrap" MinWidth="0" />
                        </Grid>
                        <Grid ColumnSpacing="10" MinWidth="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon x:Name="CredentialStatusIcon" Glyph="&#xE73E;" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <TextBlock x:Name="CredentialStatusText" Grid.Column="1" Text="正在检查 Provider" TextWrapping="Wrap" MinWidth="0" />
                        </Grid>
                        <Button Content="打开诊断" HorizontalAlignment="Left" Tag="navigate:diagnostics" />
                    </StackPanel>
                </Border>
            </Grid>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Wide" />
                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="NativeModeCard.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="ManagedModeCard.(Grid.Row)" Value="1" />
                            <Setter Target="ManagedModeCard.(Grid.Column)" Value="0" />
                            <Setter Target="ManagedModeCard.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="MainAgentCard.(Grid.ColumnSpan)" Value="3" />
                            <Setter Target="WorkerCard.(Grid.Row)" Value="1" />
                            <Setter Target="WorkerCard.(Grid.Column)" Value="0" />
                            <Setter Target="WorkerCard.(Grid.ColumnSpan)" Value="3" />
                            <Setter Target="BudgetCard.(Grid.Row)" Value="2" />
                            <Setter Target="BudgetCard.(Grid.Column)" Value="0" />
                            <Setter Target="BudgetCard.(Grid.ColumnSpan)" Value="3" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="VeryWide">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1500" /></VisualState.StateTriggers>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </StackPanel>
    </ScrollViewer>
</Page>
