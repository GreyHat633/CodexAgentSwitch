<Page x:Class="CodexAgentSwitch.App.Views.DashboardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><StackPanel Padding="{StaticResource PagePadding}" Spacing="18" MaxWidth="{StaticResource PageContentMaxWidth}" HorizontalAlignment="Center">
  <StackPanel Spacing="4"><TextBlock Text="Agent Switch 运行概览" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="StateText" Text="正在读取状态" Style="{StaticResource CaptionTextStyle}"/></StackPanel>
  <InfoBar x:Name="DashboardActionBar" IsOpen="False"/>
  <Border Style="{StaticResource CardBorderStyle}"><StackPanel Spacing="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="配置项目" Style="{StaticResource SectionTitleStyle}"/><Button Grid.Column="1" Content="项目配置" HorizontalAlignment="Right" Tag="navigate:native-projects"/></Grid><ItemsControl ItemsSource="{x:Bind Projects}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="12" Margin="0,0,0,8" CornerRadius="8" Background="{ThemeResource ControlFillColorDefaultBrush}"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding WorkingDirectory}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Profile}"/><TextBlock Text="{Binding Applied}" Style="{StaticResource CaptionTextStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding MainAgent}"/><TextBlock Text="{Binding Worker}" Style="{StaticResource CaptionTextStyle}"/></StackPanel><StackPanel Grid.Column="3" Spacing="6"><TextBlock Text="{Binding State}"/><StackPanel Orientation="Horizontal" Spacing="6"><Button Content="启动 Codex" Tag="dashboard:launch-desktop"/><Button Content="重新配置" Tag="navigate:native-projects"/></StackPanel></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="ProjectsEmpty" Text="还没有配置项目。请先进入项目配置并应用方案。" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/></StackPanel></Border>
  <Border Style="{StaticResource CardBorderStyle}"><StackPanel Spacing="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="最近活动任务" Style="{StaticResource SectionTitleStyle}"/><Button Grid.Column="1" Content="查看全部活动" HorizontalAlignment="Right" Tag="navigate:tasks"/></Grid><ItemsControl ItemsSource="{x:Bind Tasks}"><ItemsControl.ItemTemplate><DataTemplate><Grid Padding="6" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Project}" FontWeight="SemiBold"/><TextBlock Text="{Binding Title}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Worker}"/><TextBlock Grid.Column="2" Text="{Binding State}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="TasksEmpty" Text="当前没有活动任务。Agent Switch 已就绪；Sol 委派 Worker 后会在这里显示进度。" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/></StackPanel></Border>
 </StackPanel></ScrollViewer>
</Page>
