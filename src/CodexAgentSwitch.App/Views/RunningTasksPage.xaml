<Page
    x:Class="CodexAgentSwitch.App.Views.RunningTasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CodexAgentSwitch.App.Views"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20" MaxWidth="1180">
            <local:PageHeader Title="运行任务" Subtitle="在 Agent Switch 内创建受控 Thread；主代理负责最终结果，工作代理依据当前方案运行。" />

            <InfoBar x:Name="TaskActionBar" IsOpen="False" IsClosable="True" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="新建受控任务" Style="{StaticResource SectionTitleStyle}" />
                    <TextBox
                        x:Name="TaskInputTextBox"
                        Header="任务内容"
                        PlaceholderText="输入要交给当前方案执行的任务"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="104"
                        AutomationProperties.Name="任务内容" />
                    <TextBox
                        x:Name="WorkingDirectoryTextBox"
                        Header="工作目录"
                        PlaceholderText="例如 E:\AISPace\主模型项目区"
                        AutomationProperties.Name="任务工作目录" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            x:Name="UseWorkerCheckBox"
                            Content="允许当前方案调用工作代理"
                            IsChecked="True"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            x:Name="StartTaskButton"
                            Content="运行任务"
                            Style="{StaticResource AccentButtonStyle}"
                            Tag="task:start"
                            AutomationProperties.Name="运行真实受控任务" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="300" />
                    <ColumnDefinition Width="3*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="真实任务" Style="{StaticResource SectionTitleStyle}" />
                            <Button HorizontalAlignment="Right" Content="刷新" Tag="task:refresh" />
                        </Grid>
                        <TextBlock x:Name="EmptyTasksText" Text="尚未创建受控任务。" Style="{StaticResource CaptionTextStyle}" />
                        <ListView
                            x:Name="TaskListView"
                            MinHeight="320"
                            SelectionChanged="OnTaskSelectionChanged"
                            AutomationProperties.Name="真实任务列表">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Metadata}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource StatusBadgeStyle}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Status}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel x:Name="TaskDetailsPanel" Spacing="12">
                        <TextBlock x:Name="TaskTitleText" Text="选择任务查看详情" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="TaskMetadataText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        <InfoBar x:Name="TaskStatusBar" IsOpen="False" IsClosable="False" />
                        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TaskMessagesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CompactCardBorderStyle}" Margin="0,0,0,8">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{Binding Actor}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <TextBlock Text="{Binding Timestamp}" Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBox
                            x:Name="ContinueInputTextBox"
                            Header="继续此任务"
                            PlaceholderText="向同一个主 Thread 提交下一轮内容"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="76" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ContinueTaskButton" Content="提交下一轮" Style="{StaticResource AccentButtonStyle}" Tag="task:continue" />
                            <Button x:Name="CancelTaskButton" Content="取消运行" Tag="task:cancel" />
                            <Button x:Name="ApproveTaskButton" Content="批准" Tag="task:approve" Visibility="Collapsed" />
                            <Button x:Name="DeclineTaskButton" Content="拒绝" Tag="task:decline" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
