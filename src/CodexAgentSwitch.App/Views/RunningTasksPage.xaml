<Page
    x:Class="CodexAgentSwitch.App.Views.RunningTasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CodexAgentSwitch.App.Views">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="24" MaxWidth="1180">
            <local:PageHeader Title="运行任务" Subtitle="主代理拥有最终责任；Worker 只能在已登记边界内工作。" />
            <InfoBar IsOpen="True" Severity="Informational" Title="当前没有正在运行的任务" Message="以下内容为 UI Gallery 使用的完整运行态示例。" />
            <Border Style="{StaticResource CardBorderStyle}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Text="主代理 · Sol high" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="正在整合功能并执行最终审查" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                            <Border Style="{StaticResource StatusBadgeStyle}"><TextBlock Text="运行中" /></Border>
                            <TextBlock Text="12:42" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar IsIndeterminate="True" AutomationProperties.Name="主代理正在运行" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CompactCardBorderStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="计划跳过" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="不再全量读取既有编排器或重建同一模块清单" Style="{StaticResource BodyTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CompactCardBorderStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="重复劳动" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="未检测到完整重复" Style="{StaticResource BodyTextStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            <Grid Margin="36,0,0,0" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="Worker 1 · Luna medium" Style="{StaticResource SectionTitleStyle}" />
                            <Border HorizontalAlignment="Right" Style="{StaticResource StatusBadgeStyle}"><TextBlock Text="运行中" /></Border>
                        </Grid>
                        <TextBlock Text="审计现有 Sol–Luna 模块与当前协议" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Text="最近进展：正在核对 App Server schema 生成命令" Style="{StaticResource CaptionTextStyle}" />
                        <ProgressBar Value="62" AutomationProperties.Name="Worker 1 估计进度 62%" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="用量" Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="unavailable" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="预算" Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="原生额度" /></StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="查看详情" />
                            <Button Content="继续等待" />
                            <Button Content="纠偏" />
                            <Button Content="取消" Foreground="{ThemeResource DangerBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="Worker 2 · Terra" Style="{StaticResource SectionTitleStyle}" />
                            <Border HorizontalAlignment="Right" Style="{StaticResource StatusBadgeStyle}"><TextBlock Text="等待批准" Foreground="{ThemeResource WarningBrush}" /></Border>
                        </Grid>
                        <TextBlock Text="测试大文件扫描性能" Style="{StaticResource BodyTextStyle}" />
                        <InfoBar IsOpen="True" Severity="Warning" Title="需要批准" Message="Worker 请求读取任务范围外文件；默认不会自动批准。" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="查看请求" Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="拒绝并纠偏" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <InfoBar IsOpen="True" Severity="Warning" Title="重复劳动提醒" Message="该范围已委派给 Worker 1。请选择等待、定向抽查、取消并接管，或记录本次允许重复的原因。" />
        </StackPanel>
    </ScrollViewer>
</Page>
