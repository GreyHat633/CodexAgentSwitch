<Page
    x:Class="CodexAgentSwitch.App.Views.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CodexAgentSwitch.App.Views">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="24" MaxWidth="1180">
            <Grid>
                <local:PageHeader Title="配置方案" Subtitle="在可逆的方案之间切换；导入和导出永远不包含 API Key。" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="导入" />
                    <Button Content="新建方案" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
            <InfoBar IsOpen="True" Severity="Success" Title="当前方案：经济模式" Message="Sol high · Luna ×1 · 每日外部预算 ¥3.00" />
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorderStyle}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="经济模式" Style="{StaticResource SectionTitleStyle}" />
                            <Border HorizontalAlignment="Right" Style="{StaticResource StatusBadgeStyle}"><TextBlock Text="默认" /></Border>
                        </Grid>
                        <TextBlock Text="Sol high · Luna · 最多 1 个 Worker" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Text="严格替代门槛，优先低成本且可独立验收的任务。" Style="{StaticResource CaptionTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="已启用" IsEnabled="False" />
                            <Button Content="复制" />
                            <Button Content="导出" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="平衡模式" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Sol high · Luna / Terra · 最多 2 个 Worker" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Text="在成本、速度与可靠性之间取得平衡。" Style="{StaticResource CaptionTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="立即启用" Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="复制" />
                            <Button Content="更多" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="性能模式" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Sol xhigh · 原生 Worker · 最多 3 个" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Text="仅在三个任务真正独立时并行，不重复探索同一根因。" Style="{StaticResource CaptionTextStyle}" />
                        <Button Content="立即启用" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="单人模式" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Sol high · 不使用 Worker" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Text="适合敏感、强耦合或不值得分包的任务。" Style="{StaticResource CaptionTextStyle}" />
                        <Button Content="立即启用" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
