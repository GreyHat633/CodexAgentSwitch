<Page
    x:Class="CodexAgentSwitch.App.Views.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CodexAgentSwitch.App.Views">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveLayoutStates">
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderActions.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderActions.HorizontalAlignment" Value="Left" />
                        <Setter Target="SavedProfilesCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="CurrentProfileCard.(Grid.Row)" Value="1" />
                        <Setter Target="CurrentProfileCard.(Grid.Column)" Value="0" />
                        <Setter Target="CurrentProfileCard.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer>
            <StackPanel Padding="{StaticResource PagePadding}" Spacing="16" MaxWidth="{StaticResource PageContentMaxWidth}" HorizontalAlignment="Center">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <local:PageHeader Title="配置方案" Subtitle="创建、编辑并持久化 Sol / Terra / Luna 路由方案。导入和导出不包含凭据。" />
                    <StackPanel x:Name="HeaderActions" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="导入" Tag="profile:import" />
                        <Button Content="新建方案" Style="{StaticResource AccentButtonStyle}" Tag="profile:new" AutomationProperties.Name="新建方案" />
                    </StackPanel>
                </Grid>
                <InfoBar x:Name="CurrentProfileBar" IsOpen="True" Severity="Informational" Title="正在加载配置方案" Message="从本地数据库读取。" />
                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <Border x:Name="SavedProfilesCard" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="已保存方案" Style="{StaticResource SectionTitleStyle}" />
                            <ListView x:Name="ProfileList" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" SelectionMode="Single" MinHeight="320" AutomationProperties.Name="配置方案列表">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextStyle}" />
                                                 <TextBlock Text="{Binding KindLabel}" Style="{StaticResource CaptionTextStyle}" />
                                                 <TextBlock Text="{Binding ApprovalModeLabel}" Style="{StaticResource CaptionTextStyle}" />
                                                 <TextBlock Text="{Binding ExternalWorkerPermissionLabel}" Visibility="{Binding ExternalWorkerPermissionVisibility}" Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock Text="{Binding RepairMessage}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource StatusBadgeStyle}" Visibility="{Binding DefaultVisibility}">
                                                <TextBlock Text="{Binding DefaultLabel}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                                <ItemsControl HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal"
                                                           MaximumRowsOrColumns="4"
                                                           HorizontalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <Button Content="编辑" Width="56" Margin="4" Padding="8,6" Click="EditSelectedProfile" />
                                    <Button Content="复制" Width="56" Margin="4" Padding="8,6" Click="CopySelectedProfile" />
                                    <Button Content="删除" Width="56" Margin="4" Padding="8,6" Click="DeleteSelectedProfile" />
                                    <Button Content="导出" Width="56" Margin="4" Padding="8,6" Click="ExportSelectedProfile" />
                                </ItemsControl>
                                <ItemsControl HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal"
                                                           MaximumRowsOrColumns="2"
                                                           HorizontalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <Button Content="设置默认" Width="120" Margin="4" Click="SetSelectedAsDefault" Style="{StaticResource AccentButtonStyle}" />
                                    <Button Content="立即启用" Width="120" Margin="4" Click="ActivateSelectedProfile" Style="{StaticResource AccentButtonStyle}" />
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="CurrentProfileCard" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="当前方案" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="CurrentProfileNameText" Text="未选择" Style="{StaticResource BodyTextStyle}" />
                            <TextBlock x:Name="CurrentProfileSummaryText" Text="" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="选择列表中的方案后，可编辑、复制、删除、设为默认或导出。" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <ContentDialog x:Name="ProfileEditorDialog"
                       DataContext="{Binding Editor}"
                       Title="{Binding DialogTitle}"
                       PrimaryButtonText="保存"
                       CloseButtonText="取消"
                       PrimaryButtonClick="SaveEditor"
                       DefaultButton="Primary"
                       Width="860"
                       MaxWidth="900">
            <ScrollViewer MaxHeight="680">
                <StackPanel Spacing="20">
                    <TextBox Header="方案名称" Text="{Binding Name, Mode=TwoWay}" AutomationProperties.Name="方案名称" />
                    <TextBlock Text="主代理" Style="{StaticResource SectionTitleStyle}" />
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /></Grid.RowDefinitions>
                        <ComboBox Grid.Row="0" Grid.Column="0" Header="主代理" ItemsSource="{Binding MainAgentSlots}" SelectedItem="{Binding MainAgentSlot, Mode=TwoWay}" AutomationProperties.Name="主代理选择" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  Header="推理强度"
                                  ItemsSource="{Binding ReasoningStrengthOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedReasoningStrengthOption, Mode=TwoWay}"
                                  AutomationProperties.Name="主代理推理强度" />
                    </Grid>
                    <InfoBar IsOpen="True"
                             Severity="Warning"
                             Title="当前账户不支持所选主代理"
                             Message="{Binding MainAgentUnavailableMessage}"
                             Visibility="{Binding MainAgentUnavailableVisibility}" />
                    <TextBlock Text="批准与访问" Style="{StaticResource SectionTitleStyle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Header="批准操作模式"
                                  ItemsSource="{Binding ApprovalModeOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedApprovalModeOption, Mode=TwoWay}"
                                  AutomationProperties.Name="批准操作模式" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ApprovalModeDescription}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </Grid>
                    <InfoBar IsOpen="True"
                             Severity="Error"
                             Title="完全自动模式具有高风险"
                             Message="主代理与原生 Worker 将使用 never 批准策略和 danger-full-access 沙箱；外部 Worker 的本地工具权限由下方独立设置控制。"
                             Visibility="{Binding FullAutoWarningVisibility}" />
                    <StackPanel Spacing="12">
                        <TextBlock Text="工作代理与路由" Style="{StaticResource SectionTitleStyle}" />
                        <CheckBox Content="启用工作代理"
                                  IsChecked="{Binding WorkerEnabled, Mode=TwoWay}"
                                  AutomationProperties.Name="启用工作代理" />
                        <TextBlock Text="已关闭工作代理，所有任务将由主代理独立完成。"
                                   Visibility="{Binding WorkerDisabledHintVisibility}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <StackPanel Visibility="{Binding WorkerSettingsVisibility}" Spacing="12">
                            <InfoBar IsOpen="True"
                                     Severity="Warning"
                                     Title="当前账户不支持所选原生 Worker"
                                     Message="{Binding NativeWorkerUnavailableMessage}"
                                     Visibility="{Binding NativeWorkerUnavailableVisibility}" />
                            <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <ComboBox Grid.Row="0" Grid.Column="0"
                                          Header="工作代理来源"
                                          ItemsSource="{Binding WorkerSourceOptions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedItem="{Binding SelectedWorkerSourceOption, Mode=TwoWay}"
                                          AutomationProperties.Name="工作代理来源" />
                                <TextBox Grid.Row="0" Grid.Column="2"
                                         Header="最大工作代理数量"
                                         Text="{Binding WorkerCount, Mode=TwoWay}"
                                         AutomationProperties.Name="最大工作代理数量" />
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          Header="原生工作代理"
                                          ItemsSource="{Binding NativeWorkerSlots}"
                                          SelectedItem="{Binding NativeWorkerSlot, Mode=TwoWay}"
                                          Visibility="{Binding NativeWorkerVisibility}"
                                          AutomationProperties.Name="原生工作代理选择" />
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          Header="外部服务商"
                                          ItemsSource="{Binding ExternalProviders}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding ExternalProviderId, Mode=TwoWay}"
                                          IsEnabled="{Binding HasExternalProviders}"
                                          Visibility="{Binding ExternalProviderVisibility}"
                                          AutomationProperties.Name="外部服务商选择" />
                                 <ComboBox Grid.Row="2" Grid.Column="0"
                                           Header="Worker 推理强度"
                                          ItemsSource="{Binding WorkerReasoningStrengthOptions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedItem="{Binding SelectedWorkerReasoningStrengthOption, Mode=TwoWay}"
                                           Visibility="{Binding NativeWorkerVisibility}"
                                           AutomationProperties.Name="Worker 推理强度" />
                                 <ComboBox Grid.Row="2" Grid.Column="0"
                                           Header="外部 Worker 权限"
                                           ItemsSource="{Binding ExternalWorkerPermissionOptions}"
                                           DisplayMemberPath="DisplayName"
                                           SelectedItem="{Binding SelectedExternalWorkerPermissionOption, Mode=TwoWay}"
                                           Visibility="{Binding ExternalProviderVisibility}"
                                           AutomationProperties.Name="外部 Worker 权限" />
                                 <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                            Text="{Binding ExternalWorkerPermissionDescription}"
                                            Visibility="{Binding ExternalProviderVisibility}"
                                            Style="{StaticResource CaptionTextStyle}"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="外部 Worker 权限说明" />
                                <ComboBox Grid.Row="1" Grid.Column="0"
                                          Header="路由模式"
                                          ItemsSource="{Binding RoutingModeOptions}"
                                          SelectedItem="{Binding SelectedRoutingModeOption, Mode=TwoWay}"
                                          ToolTipService.ToolTip="{Binding RoutingModeDescription}"
                                          AutomationProperties.Name="路由模式">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       ToolTipService.ToolTip="{Binding Description}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox Grid.Row="1" Grid.Column="1"
                                          Header="回退策略"
                                          ItemsSource="{Binding FallbackActionOptions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedItem="{Binding SelectedFallbackActionOption, Mode=TwoWay}"
                                          AutomationProperties.Name="回退策略" />
                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Text="{Binding RoutingModeDescription}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           ToolTipService.ToolTip="{Binding RoutingModeDescription}"
                                           AutomationProperties.Name="路由模式说明" />
                            </Grid>
                            <InfoBar IsOpen="True"
                                     Severity="Warning"
                                     Title="没有可用的外部服务商"
                                     Message="请先在服务商页面配置并启用一个外部服务商。"
                                     Visibility="{Binding ExternalProviderEmptyVisibility}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="预算限制" Style="{StaticResource SectionTitleStyle}" />
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <TextBox Grid.Row="0" Grid.Column="0" Header="单任务预算" Text="{Binding PerTaskBudget, Mode=TwoWay}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Header="每日预算" Text="{Binding DailyBudget, Mode=TwoWay}" />
                        <TextBox Grid.Row="0" Grid.Column="2" Header="每月预算" Text="{Binding MonthlyBudget, Mode=TwoWay}" />
                        <TextBox Grid.Row="1" Grid.Column="0" Header="令牌上限" Text="{Binding TokenLimit, Mode=TwoWay}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Header="请求上限" Text="{Binding RequestLimit, Mode=TwoWay}" />
                        <TextBox Grid.Row="1" Grid.Column="2" Header="币种" Text="{Binding Currency, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Page>
