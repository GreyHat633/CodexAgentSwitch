<UserControl
    x:Class="CodexAgentSwitch.App.Views.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="4">
        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" Opacity="0.72" />
    </StackPanel>
</UserControl>
